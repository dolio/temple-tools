cabal-version: 3.14
name: dat-tools
version: 0.1.0.0
synopsis: Simple tool for working with Troika DAT files
license: GPL-3.0-or-later
license-file: LICENSE
author: Dan Doel
maintainer: dan.doel@gmail.com
copyright: 2025
category: Game
build-type: Simple
extra-doc-files: CHANGELOG.md

description:
  Discern DAT is a program for extracting Troika DAT archives, used in
  for instance the Temple of Elemental Evil PC game. It can also merely
  list the contents of a file, showing what structure would be created.

  No effort is made to avoid overwriting files, so take care.

common settings
  ghc-options:
    -Wall -Wno-unused-do-bind -Wno-name-shadowing -Wno-overflowed-literals

  default-extensions:
    BlockArguments
    OverloadedStrings
    RecordWildCards
    ViewPatterns

library dat-format
  import: settings

  hs-source-dirs: lib
  default-language: GHC2024

  build-depends:
    base ^>=4.20.1.0,
    bytestring ^>=0.12.2.0,
    cereal ^>=0.5.8.3,
    directory ^>=1.3.8.5,
    filepath ^>=1.5.4.0,
    mtl ^>=2.3.1,
    unordered-containers ^>=0.2.20,
    zlib ^>=0.7.1.0

  exposed-modules:
    Temple.Dat.Entry
    Temple.Dat.Footer
    Temple.Dat.Tree

executable discern-dat
  import: settings
  main-is: Main.hs

  build-depends:
    base ^>=4.20.1.0,
    optparse-applicative ^>=0.19.0.0,
    dat-tools:dat-format

  hs-source-dirs: discern
  default-language: GHC2024
