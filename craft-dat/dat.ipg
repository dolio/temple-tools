// Interval Parsing Grammar for the information section of a Troika DAT
// file. This parses the footer (which specifies the DAT version and file
// table location) and read the file entries, which allows reconstructing
// the directory structure. The actual file data is stored elsewhere in the
// file, at locations indicated by the entries.

// The pre/postamble allows the IPG compiler to build this file into a
// simple JavaScript program that will dump information about the entries
// of ToEE1.dat. The intention of this file is mainly for documentation,
// though. A Rust parser can also be generated, although the pre/postable
// would be nonsensical there.

// The IPG compiler targeted is available at:
//
//     https://github.com/derekelkins/ipgcc

const fs = require("node:fs");

function is_directory(entry) {
  return (entry.attributes & 0x400) == 0x400;
}

function is_compressed(entry) {
  return (entry.attributes & 0x2) == 0x2;
}

function empty_guid() {
  return {guid_bytes: Array.fill(0, 0, 16)};
}

function make_guid(bytes) {
  return {guid_bytes: new Uint8Array(bytes)};
}
  
function decode_ascii(bytes) {
  return new TextDecoder("ascii").decode(new Uint8Array(bytes));
}

function data_start(entry) {
  return entry.data_start;
}

function data_end(entry) {
  return entry.data_start + entry.archived_size;
}

function name(entry) {
  return entry.name;
}

full_paths = [];

function full_path(i) {
  if (i == -1) {
    return "dat-root";
  } else {
    return full_paths[i];
  }
}

function process_entry(i, entry, data) {
  ppath = full_path(entry.parent_entry);
  fpath = ppath + "/" + entry.name;
  full_paths[i] = fpath;

  dpath = fpath + (is_directory(entry) ? "/" : is_compressed(entry) ? "%" : "");
  console.log(dpath);

  return 0;
}

%preamble_end

DAT ->
  // Data before this is the (possibly compressed) file data. It can
  // probably contain arbitrary other data, as well, similar to a zip file.

  // total number of bytes preceding the entry table, _including_ this U32
  U32 { pre_table_size = U32.value }
  Entries(Footer.table_offset)
  { entries = Entries.entries }
  GUID(Footer.version)[Footer.START - 16, Footer.START]
    { guid = GUID.value }
  Footer[EOI-12, EOI]
    { version = Footer.version };

Footer ->
  Signature { version = Signature.version }
  U32 { names_size = U32.value } // total size of names in Entries
  U32 { table_offset = U32.value };

rule GUID(version : Int);
GUID(version)
  -> ?[ version == 0 ]
     { value = empty_guid() }
   / ?[ version == 1 ]
     { bytes = * }
     { value = make_guid(bytes) };

U32 -> { bs = *[4] }
       { value = bs[0] | (bs[1] << 8) | (bs[2] << 16) | (bs[3] << 24) };

Signature
  -> " TAD" { version = 0 }
   / "1TAD" { version = 1 };

FileTable ->
  U32 { num_entries = U32.value }
  repeat Entry.this {entries = values};

rule Entries(table_offset : Int);
Entries(table_offset) ->
  U32[EOI - table_offset, EOI - table_offset + 4]
  { num_entries = U32.value }
  repeat Entry.this
  { entries = values }
  for i = 0 to num_entries do
    EntryData(i, entries[i])[data_start(entries[i]), data_end(entries[i])];

Entry ->
  U32
  EntryName[U32.value]
  { name = decode_ascii(EntryName.name) }
  U32 // probably original pointer to name
  U32 { attributes = U32.value } // 0x400 directory, 0x2 compressed
  U32 { original_size = U32.value }
  U32 { archived_size = U32.value }
  U32 { data_start = U32.value }
  U32 { parent_entry = U32.value }
  U32 { first_child_entry = U32.value }
  U32 { next_sibling_entry = U32.value };

EntryName -> { name = *[EOI-1] } "\x00";

EntryData(i, entry) ->
  { data = * }
  { _ = process_entry(i, entry, data) };

%postamble_begin

DAT(fs.readFileSync("ToEE1.dat"));
