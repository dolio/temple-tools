cabal-version: 3.14
name: polymorph-mob
version: 0.1.0.0
synopsis: Edit binary MOB files for ToEE
license: GPL-3.0-or-later
license-file: LICENSE
author: Dan Doel
maintainer: dan.doel@gmail.com
copyright: 2025
category: Game
build-type: Simple
extra-doc-files: CHANGELOG.md

common warnings
    ghc-options: -Wall -Wno-unused-do-bind

executable polymorph-mob
    import: warnings

    main-is: Main.hs

    other-modules:
      Decode
      Display
      Mob

    build-depends:
      base ^>=4.20.1.0,
      binary ^>=0.8.9.3,
      bytestring ^>=0.12.2.0,
      containers ^>=0.7,
      filepath ^>=1.5.4.0,
      knowledge-objects ^>= 0.1.0.0,
      optparse-applicative ^>=0.19.0.0,
      uuid ^>=1.3.16

    hs-source-dirs: exe

    default-language: GHC2024
    default-extensions: BlockArguments OverloadedStrings RecordWildCards
